kernel @dead_code(ptr.i32 %out.0) {
entry:
  %1 = special i32 tid.x
  %i.2 = copy i32 %1
  %s.3 = copy i32 0
  %k.4 = copy i32 0
  jmp for.cond.1
for.cond.1:
  %5 = lt i32 %k.4, 10
  br %5, for.body.2, for.end.4
for.body.2:
  %6 = eq i32 %k.4, %i.2
  br %6, if.then.5, if.end.6
if.then.5:
  jmp for.step.3
dead.7:
  %7 = add i32 %s.3, 1000
  %s.3 = copy i32 %7
  jmp if.end.6
if.end.6:
  %8 = gt i32 %k.4, 6
  br %8, if.then.8, if.end.9
if.then.8:
  jmp for.end.4
dead.10:
  %9 = add i32 %s.3, 2000
  %s.3 = copy i32 %9
  jmp if.end.9
if.end.9:
  %10 = add i32 %s.3, %k.4
  %s.3 = copy i32 %10
  jmp for.step.3
for.step.3:
  %11 = add i32 %k.4, 1
  %k.4 = copy i32 %11
  jmp for.cond.1
for.end.4:
  %12 = eq i32 %i.2, 3
  br %12, if.then.11, if.end.12
if.then.11:
  %13 = neg i32 1
  store i32 global %out.0[%i.2], %13
  ret
dead.13:
  %14 = neg i32 2
  store i32 global %out.0[%i.2], %14
  jmp if.end.12
if.end.12:
  store i32 global %out.0[%i.2], %s.3
  ret
}
