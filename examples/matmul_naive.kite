// C (m x n) = A (m x k) * B (k x n), one thread per output element, 2-D grid.
// @kernel matmul_naive
// @grid 4 4
// @block 16 16
// @arg m i32 64
// @arg n i32 64
// @arg k i32 64
// @arg a f32[4096] rand(8)
// @arg b f32[4096] rand(9)
// @arg c f32[4096] zeros
// @check c

kernel matmul_naive(m: i32, n: i32, k: i32, a: *f32, b: *f32, c: *f32) {
    var row: i32 = block_idx.y * block_dim.y + thread_idx.y;
    var col: i32 = block_idx.x * block_dim.x + thread_idx.x;
    if (row < m && col < n) {
        var acc: f32 = 0.0;
        for (var i: i32 = 0; i < k; i += 1) {
            acc += a[row * k + i] * b[i * n + col];
        }
        c[row * n + col] = acc;
    }
}
