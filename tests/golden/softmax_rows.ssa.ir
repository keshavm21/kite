kernel @softmax_rows(i32 %rows.0, i32 %cols.1, ptr.f32 %x.2, ptr.f32 %y.3) {
entry:
  %4 = special i32 ctaid.x
  %5 = special i32 ntid.x
  %6 = mul i32 %4, %5
  %7 = special i32 tid.x
  %8 = add i32 %6, %7
  %r.9 = copy i32 %8
  %10 = ge i32 %r.9, %rows.0
  br %10, if.then.1, if.end.2
if.then.1:
  ret
if.end.2:
  %11 = mul i32 %r.9, %cols.1
  %base.12 = copy i32 %11
  %13 = load f32 global %x.2[%base.12]
  %m.39 = copy f32 %13
  %c.40 = copy i32 1
  jmp for.cond.3
for.cond.3:
  %m.41 = phi f32 [%m.39, if.end.2], [%m.52, for.step.5]
  %c.42 = phi i32 [%c.40, if.end.2], [%c.53, for.step.5]
  %16 = lt i32 %c.42, %cols.1
  br %16, for.body.4, for.end.6
for.body.4:
  %17 = add i32 %base.12, %c.42
  %18 = load f32 global %x.2[%17]
  %19 = max f32 %m.41, %18
  %m.52 = copy f32 %19
  jmp for.step.5
for.step.5:
  %20 = add i32 %c.42, 1
  %c.53 = copy i32 %20
  jmp for.cond.3
for.end.6:
  %sum.43 = copy f32 0.0
  %c.44 = copy i32 0
  jmp for.cond.7
for.cond.7:
  %sum.45 = phi f32 [%sum.43, for.end.6], [%sum.50, for.step.9]
  %c.46 = phi i32 [%c.44, for.end.6], [%c.51, for.step.9]
  %23 = lt i32 %c.46, %cols.1
  br %23, for.body.8, for.end.10
for.body.8:
  %24 = add i32 %base.12, %c.46
  %25 = load f32 global %x.2[%24]
  %26 = sub f32 %25, %m.41
  %27 = exp f32 %26
  %e.28 = copy f32 %27
  %29 = add i32 %base.12, %c.46
  store f32 global %y.3[%29], %e.28
  %30 = add f32 %sum.45, %e.28
  %sum.50 = copy f32 %30
  jmp for.step.9
for.step.9:
  %31 = add i32 %c.46, 1
  %c.51 = copy i32 %31
  jmp for.cond.7
for.end.10:
  %c.47 = copy i32 0
  jmp for.cond.11
for.cond.11:
  %c.48 = phi i32 [%c.47, for.end.10], [%c.49, for.step.13]
  %33 = lt i32 %c.48, %cols.1
  br %33, for.body.12, for.end.14
for.body.12:
  %34 = add i32 %base.12, %c.48
  %35 = add i32 %base.12, %c.48
  %36 = load f32 global %y.3[%35]
  %37 = div f32 %36, %sum.45
  store f32 global %y.3[%34], %37
  jmp for.step.13
for.step.13:
  %38 = add i32 %c.48, 1
  %c.49 = copy i32 %38
  jmp for.cond.11
for.end.14:
  ret
}
