kernel @float_edge(ptr.f32 %y.0, ptr.i32 %q.1) {
entry:
  %3 = div f32 0.0, 0.0
  store f32 global %y.0[0], 16777216.0
  %7 = max f32 %3, 1.0
  store f32 global %y.0[1], %7
  %8 = min f32 2.0, %3
  store f32 global %y.0[2], %8
  store f32 global %y.0[3], 0.300000012
  %10 = ne f32 %3, %3
  %11 = btoi %10
  store i32 global %q.1[0], %11
  %12 = lt f32 %3, 1.0
  %13 = btoi %12
  %14 = ge f32 %3, 1.0
  %15 = btoi %14
  %16 = add i32 %13, %15
  store i32 global %q.1[1], %16
  %17 = eq f32 %3, %3
  %18 = btoi %17
  store i32 global %q.1[2], %18
  store i32 global %q.1[3], -2
  ret
}
