// i32 wraps around; / and % truncate toward zero; -2147483648 is a single literal.
// @kernel int_edge
// @grid 1
// @block 1
// @arg out i32[8] zeros
// @check out

kernel int_edge(out: *i32) {
    var big: i32 = 2147483647;
    out[0] = big + 1;
    out[1] = -2147483648;
    out[2] = big * big;
    out[3] = (0 - big - 1) / 3;
    out[4] = -7 % 3;
    out[5] = -(-2147483648);
    out[6] = abs(-2147483648);
    out[7] = min(-2147483648, big) - 1;
}
