kernel @matmul_tiled(i32 %m.0, i32 %n.1, i32 %k.2, ptr.f32 %a.3, ptr.f32 %b.4, ptr.f32 %c.5) {
  shared f32 @ta[256]
  shared f32 @tb[256]
entry:
  %6 = special i32 tid.x
  %tx.7 = copy i32 %6
  %8 = special i32 tid.y
  %ty.9 = copy i32 %8
  %10 = special i32 ctaid.y
  %11 = mul i32 %10, 16
  %12 = add i32 %11, %ty.9
  %row.13 = copy i32 %12
  %14 = special i32 ctaid.x
  %15 = mul i32 %14, 16
  %16 = add i32 %15, %tx.7
  %col.17 = copy i32 %16
  %acc.18 = copy f32 0.0
  %t.19 = copy i32 0
  jmp for.cond.1
for.cond.1:
  %20 = add i32 %k.2, 15
  %21 = div i32 %20, 16
  %22 = lt i32 %t.19, %21
  br %22, for.body.2, for.end.4
for.body.2:
  %23 = mul i32 %t.19, 16
  %24 = add i32 %23, %tx.7
  %ac.25 = copy i32 %24
  %26 = mul i32 %t.19, 16
  %27 = add i32 %26, %ty.9
  %br.28 = copy i32 %27
  %29 = lt i32 %row.13, %m.0
  br %29, and.rhs.8, if.else.6
and.rhs.8:
  %30 = lt i32 %ac.25, %k.2
  br %30, if.then.5, if.else.6
if.then.5:
  %31 = mul i32 %ty.9, 16
  %32 = add i32 %31, %tx.7
  %33 = mul i32 %row.13, %k.2
  %34 = add i32 %33, %ac.25
  %35 = load f32 global %a.3[%34]
  store f32 shared @ta[%32], %35
  jmp if.end.7
if.else.6:
  %36 = mul i32 %ty.9, 16
  %37 = add i32 %36, %tx.7
  store f32 shared @ta[%37], 0.0
  jmp if.end.7
if.end.7:
  %38 = lt i32 %br.28, %k.2
  br %38, and.rhs.12, if.else.10
and.rhs.12:
  %39 = lt i32 %col.17, %n.1
  br %39, if.then.9, if.else.10
if.then.9:
  %40 = mul i32 %ty.9, 16
  %41 = add i32 %40, %tx.7
  %42 = mul i32 %br.28, %n.1
  %43 = add i32 %42, %col.17
  %44 = load f32 global %b.4[%43]
  store f32 shared @tb[%41], %44
  jmp if.end.11
if.else.10:
  %45 = mul i32 %ty.9, 16
  %46 = add i32 %45, %tx.7
  store f32 shared @tb[%46], 0.0
  jmp if.end.11
if.end.11:
  barrier
  %i.47 = copy i32 0
  jmp for.cond.13
for.cond.13:
  %48 = lt i32 %i.47, 16
  br %48, for.body.14, for.end.16
for.body.14:
  %49 = mul i32 %ty.9, 16
  %50 = add i32 %49, %i.47
  %51 = load f32 shared @ta[%50]
  %52 = mul i32 %i.47, 16
  %53 = add i32 %52, %tx.7
  %54 = load f32 shared @tb[%53]
  %55 = mul f32 %51, %54
  %56 = add f32 %acc.18, %55
  %acc.18 = copy f32 %56
  jmp for.step.15
for.step.15:
  %57 = add i32 %i.47, 1
  %i.47 = copy i32 %57
  jmp for.cond.13
for.end.16:
  barrier
  jmp for.step.3
for.step.3:
  %58 = add i32 %t.19, 1
  %t.19 = copy i32 %58
  jmp for.cond.1
for.end.4:
  %59 = lt i32 %row.13, %m.0
  br %59, and.rhs.19, if.end.18
and.rhs.19:
  %60 = lt i32 %col.17, %n.1
  br %60, if.then.17, if.end.18
if.then.17:
  %61 = mul i32 %row.13, %n.1
  %62 = add i32 %61, %col.17
  store f32 global %c.5[%62], %acc.18
  jmp if.end.18
if.end.18:
  ret
}
