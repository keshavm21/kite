kernel @scopes(i32 %n.0, ptr.i32 %out.1) {
entry:
  %x.2 = copy i32 1
  %3 = gt i32 %n.0, 0
  br %3, if.then.1, if.end.2
if.then.1:
  %x.4 = copy i32 2
  store i32 global %out.1[0], %x.4
  jmp if.end.2
if.end.2:
  %i.20 = copy i32 0
  jmp for.cond.3
for.cond.3:
  %i.21 = phi i32 [%i.20, if.end.2], [%i.29, for.step.5]
  %6 = lt i32 %i.21, 2
  br %6, for.body.4, for.end.6
for.body.4:
  %x.7 = copy f32 0.5
  %8 = ftoi %x.7
  store i32 global %out.1[%i.21], %8
  jmp for.step.5
for.step.5:
  %9 = add i32 %i.21, 1
  %i.29 = copy i32 %9
  jmp for.cond.3
for.end.6:
  %i.22 = copy i32 0
  jmp for.cond.7
for.cond.7:
  %i.23 = phi i32 [%i.22, for.end.6], [%i.28, for.step.9]
  %11 = lt i32 %i.23, 2
  br %11, for.body.8, for.end.10
for.body.8:
  %12 = load i32 global %out.1[%i.23]
  %13 = add i32 %12, %x.2
  store i32 global %out.1[%i.23], %13
  jmp for.step.9
for.step.9:
  %14 = add i32 %i.23, 1
  %i.28 = copy i32 %14
  jmp for.cond.7
for.end.10:
  %j.24 = copy i32 0
  %j.25 = copy i32 0
  jmp for.cond.11
for.cond.11:
  %j.26 = phi i32 [%j.25, for.end.10], [%j.27, for.step.13]
  %16 = lt i32 %j.26, 3
  br %16, for.body.12, for.end.14
for.body.12:
  %x.17 = copy bool true
  br %x.17, if.then.15, if.end.16
if.then.15:
  jmp for.end.14
if.end.16:
  jmp for.step.13
for.step.13:
  %18 = add i32 %j.26, 1
  %j.27 = copy i32 %18
  jmp for.cond.11
for.end.14:
  %19 = add i32 %x.2, %j.26
  store i32 global %out.1[1], %19
  ret
}
