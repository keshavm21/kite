.version 7.0
.target sm_75
.address_size 64

.visible .entry casts(
    .param .u32 casts_param_0,
    .param .u64 casts_param_1,
    .param .u64 casts_param_2,
    .param .u64 casts_param_3
)
{
    .reg .pred  %p<27>;
    .reg .b32   %r<22>;
    .reg .f32   %f<24>;
    .reg .b64   %rd<33>;

    ld.param.u32        %r0, [casts_param_0];
    ld.param.u64        %rd1, [casts_param_1];
    cvta.to.global.u64  %rd1, %rd1;
    ld.param.u64        %rd2, [casts_param_2];
    cvta.to.global.u64  %rd2, %rd2;
    ld.param.u64        %rd3, [casts_param_3];
    cvta.to.global.u64  %rd3, %rd3;

$L_entry:
    mov.u32             %r4, %tid.x;
    setp.lt.s32         %p6, %r4, %r0;
    @%p6 bra            $L_if_end_2;

$L_if_then_1:
    ret;

$L_if_end_2:
    mul.wide.s32        %rd27, %r4, 4;
    add.s64             %rd28, %rd1, %rd27;
    ld.global.f32       %f7, [%rd28];
    mul.rn.f32          %f8, %f7, 0f41200000;
    cvt.rzi.s32.f32     %r10, %f8;
    setp.lt.s32         %p13, %r10, 0;
    @%p13 bra           $L_sc_true_3;

$L_or_rhs_6:
    setp.gt.s32         %p14, %r10, 5;
    @!%p14 bra          $L_sc_false_4;

$L_sc_true_3:
    mov.pred            %p26, 1;
    bra.uni             $L_sc_end_5;

$L_sc_false_4:
    mov.pred            %p26, 0;

$L_sc_end_5:
    mul.lo.s32          %r16, %r10, 2;
    selp.s32            %r17, 1, 0, %p26;
    add.s32             %r18, %r16, %r17;
    mul.wide.s32        %rd29, %r4, 4;
    add.s64             %rd30, %rd2, %rd29;
    st.global.u32       [%rd30], %r18;
    abs.f32             %f19, %f8;
    sqrt.rn.f32         %f20, %f19;
    min.s32             %r21, %r10, 3;
    cvt.rn.f32.s32      %f22, %r21;
    add.rn.f32          %f23, %f20, %f22;
    mul.wide.s32        %rd31, %r4, 4;
    add.s64             %rd32, %rd3, %rd31;
    st.global.f32       [%rd32], %f23;
    ret;
}
