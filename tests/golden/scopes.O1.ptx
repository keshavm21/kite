.version 7.0
.target sm_75
.address_size 64

.visible .entry scopes(
    .param .u32 scopes_param_0,
    .param .u64 scopes_param_1
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<48>;
    .reg .b64   %rd<2>;

    ld.param.u32        %r0, [scopes_param_0];
    ld.param.u64        %rd1, [scopes_param_1];
    cvta.to.global.u64  %rd1, %rd1;

$L_entry:
    setp.gt.s32         %p3, %r0, 0;
    @!%p3 bra           $L_if_end_2;

$L_if_then_1:
    mov.u32             %r44, 2;
    st.global.u32       [%rd1], %r44;

$L_if_end_2:
    mov.u32             %r45, 0;
    st.global.u32       [%rd1], %r45;
    mov.u32             %r46, 0;
    st.global.u32       [%rd1+4], %r46;
    ld.global.u32       %r36, [%rd1];
    add.s32             %r37, %r36, 1;
    st.global.u32       [%rd1], %r37;
    ld.global.u32       %r40, [%rd1+4];
    add.s32             %r41, %r40, 1;
    st.global.u32       [%rd1+4], %r41;
    mov.u32             %r47, 1;
    st.global.u32       [%rd1+4], %r47;
    ret;
}
