kernel @scopes(i32 %n.0, ptr.i32 %out.1) {
entry:
  %3 = gt i32 %n.0, 0
  br %3, if.then.1, if.end.2
if.then.1:
  store i32 global %out.1[0], 2
  jmp if.end.2
if.end.2:
  store i32 global %out.1[0], 0
  store i32 global %out.1[1], 0
  %36 = load i32 global %out.1[0]
  %37 = add i32 %36, 1
  store i32 global %out.1[0], %37
  %40 = load i32 global %out.1[1]
  %41 = add i32 %40, 1
  store i32 global %out.1[1], %41
  store i32 global %out.1[1], 1
  ret
}
