kernel @dead_code(ptr.i32 %out.0) {
entry:
  %1 = special i32 tid.x
  %s.17 = copy i32 0
  %k.18 = copy i32 0
  jmp for.cond.1
for.cond.1:
  %5 = lt i32 %k.18, 10
  br %5, for.body.2, for.end.4
for.body.2:
  %6 = eq i32 %k.18, %1
  br %6, if.then.5, if.end.6
if.then.5:
  %s.20 = copy i32 %s.17
  jmp for.step.3
if.end.6:
  %8 = gt i32 %k.18, 6
  br %8, if.then.8, if.end.9
if.then.8:
  jmp for.end.4
if.end.9:
  %10 = add i32 %s.17, %k.18
  %s.20 = copy i32 %10
  jmp for.step.3
for.step.3:
  %11 = add i32 %k.18, 1
  %s.17 = copy i32 %s.20
  %k.18 = copy i32 %11
  jmp for.cond.1
for.end.4:
  %12 = eq i32 %1, 3
  br %12, if.then.11, if.end.12
if.then.11:
  store i32 global %out.0[%1], -1
  ret
if.end.12:
  store i32 global %out.0[%1], %s.17
  ret
}
