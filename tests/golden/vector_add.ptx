.version 7.0
.target sm_75
.address_size 64

.visible .entry vector_add(
    .param .u32 vector_add_param_0,
    .param .u64 vector_add_param_1,
    .param .u64 vector_add_param_2,
    .param .u64 vector_add_param_3
)
{
    .reg .pred  %p<11>;
    .reg .b32   %r<10>;
    .reg .f32   %f<14>;
    .reg .b64   %rd<20>;

    ld.param.u32        %r0, [vector_add_param_0];
    ld.param.u64        %rd1, [vector_add_param_1];
    cvta.to.global.u64  %rd1, %rd1;
    ld.param.u64        %rd2, [vector_add_param_2];
    cvta.to.global.u64  %rd2, %rd2;
    ld.param.u64        %rd3, [vector_add_param_3];
    cvta.to.global.u64  %rd3, %rd3;

$L_entry:
    mov.u32             %r4, %ctaid.x;
    mov.u32             %r5, %ntid.x;
    mul.lo.s32          %r6, %r4, %r5;
    mov.u32             %r7, %tid.x;
    add.s32             %r8, %r6, %r7;
    mov.u32             %r9, %r8;
    setp.lt.s32         %p10, %r9, %r0;
    @!%p10 bra          $L_if_end_2;

$L_if_then_1:
    mul.wide.s32        %rd14, %r9, 4;
    add.s64             %rd15, %rd1, %rd14;
    ld.global.f32       %f11, [%rd15];
    mul.wide.s32        %rd16, %r9, 4;
    add.s64             %rd17, %rd2, %rd16;
    ld.global.f32       %f12, [%rd17];
    add.rn.f32          %f13, %f11, %f12;
    mul.wide.s32        %rd18, %r9, 4;
    add.s64             %rd19, %rd3, %rd18;
    st.global.f32       [%rd19], %f13;

$L_if_end_2:
    ret;
}
