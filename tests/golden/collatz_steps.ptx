.version 7.0
.target sm_75
.address_size 64

.visible .entry collatz_steps(
    .param .u32 collatz_steps_param_0,
    .param .u64 collatz_steps_param_1,
    .param .u64 collatz_steps_param_2
)
{
    .reg .pred  %p<24>;
    .reg .b32   %r<23>;
    .reg .b64   %rd<28>;

    ld.param.u32        %r0, [collatz_steps_param_0];
    ld.param.u64        %rd1, [collatz_steps_param_1];
    cvta.to.global.u64  %rd1, %rd1;
    ld.param.u64        %rd2, [collatz_steps_param_2];
    cvta.to.global.u64  %rd2, %rd2;

$L_entry:
    mov.u32             %r3, %ctaid.x;
    mov.u32             %r4, %ntid.x;
    mul.lo.s32          %r5, %r3, %r4;
    mov.u32             %r6, %tid.x;
    add.s32             %r7, %r5, %r6;
    mov.u32             %r8, %r7;
    setp.ge.s32         %p9, %r8, %r0;
    @!%p9 bra           $L_if_end_2;

$L_if_then_1:
    ret;

$L_if_end_2:
    mul.wide.s32        %rd24, %r8, 4;
    add.s64             %rd25, %rd1, %rd24;
    ld.global.u32       %r10, [%rd25];
    mov.u32             %r11, %r10;
    setp.lt.s32         %p12, %r11, 1;
    @!%p12 bra          $L_if_end_4;

$L_if_then_3:
    neg.s32             %r13, %r11;
    add.s32             %r14, %r13, 1;
    mov.u32             %r11, %r14;

$L_if_end_4:
    mov.u32             %r15, 0;

$L_while_cond_5:

$L_while_body_6:
    setp.eq.s32         %p16, %r11, 1;
    @!%p16 bra          $L_if_end_9;

$L_if_then_8:
    bra.uni             $L_while_end_7;

$L_if_end_9:
    rem.s32             %r17, %r11, 2;
    setp.eq.s32         %p18, %r17, 0;
    @!%p18 bra          $L_if_else_11;

$L_if_then_10:
    div.s32             %r19, %r11, 2;
    mov.u32             %r11, %r19;
    bra.uni             $L_if_end_12;

$L_if_else_11:
    mul.lo.s32          %r20, 3, %r11;
    add.s32             %r21, %r20, 1;
    mov.u32             %r11, %r21;

$L_if_end_12:
    add.s32             %r22, %r15, 1;
    mov.u32             %r15, %r22;
    setp.ge.s32         %p23, %r15, 1000;
    @!%p23 bra          $L_if_end_14;

$L_if_then_13:
    bra.uni             $L_while_end_7;

$L_if_end_14:
    bra.uni             $L_while_cond_5;

$L_while_end_7:
    mul.wide.s32        %rd26, %r8, 4;
    add.s64             %rd27, %rd2, %rd26;
    st.global.u32       [%rd27], %r15;
    ret;
}
