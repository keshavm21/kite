.version 7.0
.target sm_75
.address_size 64

.visible .entry row_sum(
    .param .u32 row_sum_param_0,
    .param .u32 row_sum_param_1,
    .param .u64 row_sum_param_2,
    .param .u64 row_sum_param_3
)
{
    .reg .pred  %p<14>;
    .reg .b32   %r<19>;
    .reg .f32   %f<18>;
    .reg .b64   %rd<23>;

    ld.param.u32        %r0, [row_sum_param_0];
    ld.param.u32        %r1, [row_sum_param_1];
    ld.param.u64        %rd2, [row_sum_param_2];
    cvta.to.global.u64  %rd2, %rd2;
    ld.param.u64        %rd3, [row_sum_param_3];
    cvta.to.global.u64  %rd3, %rd3;

$L_entry:
    mov.u32             %r4, %ctaid.x;
    mov.u32             %r5, %ntid.x;
    mul.lo.s32          %r6, %r4, %r5;
    mov.u32             %r7, %tid.x;
    add.s32             %r8, %r6, %r7;
    mov.u32             %r9, %r8;
    setp.ge.s32         %p10, %r9, %r0;
    @!%p10 bra          $L_if_end_2;

$L_if_then_1:
    ret;

$L_if_end_2:
    mov.f32             %f11, 0f00000000;
    mov.u32             %r12, 0;

$L_for_cond_3:
    setp.lt.s32         %p13, %r12, %r1;
    @!%p13 bra          $L_for_end_6;

$L_for_body_4:
    mul.lo.s32          %r14, %r9, %r1;
    add.s32             %r15, %r14, %r12;
    mul.wide.s32        %rd19, %r15, 4;
    add.s64             %rd20, %rd2, %rd19;
    ld.global.f32       %f16, [%rd20];
    add.rn.f32          %f17, %f11, %f16;
    mov.f32             %f11, %f17;

$L_for_step_5:
    add.s32             %r18, %r12, 1;
    mov.u32             %r12, %r18;
    bra.uni             $L_for_cond_3;

$L_for_end_6:
    mul.wide.s32        %rd21, %r9, 4;
    add.s64             %rd22, %rd3, %rd21;
    st.global.f32       [%rd22], %f11;
    ret;
}
