// Operator precedence, associativity, casts and compound-assignment desugaring.
kernel precedence(n: i32, p: *f32, q: *i32) {
    var a: i32 = 1 + 2 * 3 - 4 / 2 % 3;
    var b: bool = n < 1 || n > 5 && n != 3 == true;
    var c: f32 = -p[0] as f32 * 2.0 + 1.0e-3;
    var d: i32 = (n + 1) * -(n - 1) + max(a, min(n, 3));
    q[n * 2] += a;
    p[0] /= 2.5;
    n = n % 4;
}
