.version 7.0
.target sm_75
.address_size 64

.visible .entry casts(
    .param .u32 casts_param_0,
    .param .u64 casts_param_1,
    .param .u64 casts_param_2,
    .param .u64 casts_param_3
)
{
    .reg .pred  %p<16>;
    .reg .b32   %r<22>;
    .reg .f32   %f<24>;
    .reg .b64   %rd<30>;

    ld.param.u32        %r0, [casts_param_0];
    ld.param.u64        %rd1, [casts_param_1];
    cvta.to.global.u64  %rd1, %rd1;
    ld.param.u64        %rd2, [casts_param_2];
    cvta.to.global.u64  %rd2, %rd2;
    ld.param.u64        %rd3, [casts_param_3];
    cvta.to.global.u64  %rd3, %rd3;

$L_entry:
    mov.u32             %r4, %tid.x;
    mov.u32             %r5, %r4;
    setp.lt.s32         %p6, %r5, %r0;
    @%p6 bra            $L_if_end_2;

$L_if_then_1:
    ret;

$L_if_end_2:
    mul.wide.s32        %rd24, %r5, 4;
    add.s64             %rd25, %rd1, %rd24;
    ld.global.f32       %f7, [%rd25];
    mul.rn.f32          %f8, %f7, 0f41200000;
    mov.f32             %f9, %f8;
    cvt.rzi.s32.f32     %r10, %f9;
    mov.u32             %r11, %r10;
    setp.lt.s32         %p13, %r11, 0;
    @%p13 bra           $L_sc_true_3;

$L_or_rhs_6:
    setp.gt.s32         %p14, %r11, 5;
    @!%p14 bra          $L_sc_false_4;

$L_sc_true_3:
    mov.pred            %p12, 1;
    bra.uni             $L_sc_end_5;

$L_sc_false_4:
    mov.pred            %p12, 0;

$L_sc_end_5:
    mov.pred            %p15, %p12;
    mul.lo.s32          %r16, %r11, 2;
    selp.s32            %r17, 1, 0, %p15;
    add.s32             %r18, %r16, %r17;
    mul.wide.s32        %rd26, %r5, 4;
    add.s64             %rd27, %rd2, %rd26;
    st.global.u32       [%rd27], %r18;
    abs.f32             %f19, %f9;
    sqrt.rn.f32         %f20, %f19;
    min.s32             %r21, %r11, 3;
    cvt.rn.f32.s32      %f22, %r21;
    add.rn.f32          %f23, %f20, %f22;
    mul.wide.s32        %rd28, %r5, 4;
    add.s64             %rd29, %rd3, %rd28;
    st.global.f32       [%rd29], %f23;
    ret;
}
