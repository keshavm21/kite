kernel @control_flow(i32 %n.0, ptr.i32 %out.1) {
  shared i32 @buf[64]
entry:
  %i.2 = copy i32 0
  jmp while.cond.1
while.cond.1:
  %3 = lt i32 %i.2, %n.0
  br %3, while.body.2, while.end.3
while.body.2:
  %4 = eq i32 %i.2, 3
  br %4, if.then.4, if.else.5
if.then.4:
  %5 = add i32 %i.2, 1
  %i.2 = copy i32 %5
  jmp while.cond.1
if.else.5:
  %6 = eq i32 %i.2, 7
  br %6, if.then.7, if.else.8
if.then.7:
  jmp while.end.3
if.else.8:
  store i32 shared @buf[%i.2], %i.2
  jmp if.end.9
if.end.9:
  jmp if.end.6
if.end.6:
  %7 = add i32 %i.2, 1
  %i.2 = copy i32 %7
  jmp while.cond.1
while.end.3:
  %k.8 = copy i32 0
  jmp for.cond.10
for.cond.10:
  %9 = lt i32 %k.8, 4
  br %9, for.body.11, for.end.13
for.body.11:
  barrier
  jmp for.step.12
for.step.12:
  %10 = add i32 %k.8, 1
  %k.8 = copy i32 %10
  jmp for.cond.10
for.end.13:
  %i.2 = copy i32 0
  jmp for.cond.14
for.cond.14:
  %11 = lt i32 %i.2, 2
  br %11, for.body.15, for.end.17
for.body.15:
  store i32 global %out.1[%i.2], 1
  jmp for.step.16
for.step.16:
  %12 = sub i32 %i.2, 1
  %i.2 = copy i32 %12
  jmp for.cond.14
for.end.17:
  ret
}
