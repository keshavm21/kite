.version 7.0
.target sm_75
.address_size 64

.visible .entry scopes(
    .param .u32 scopes_param_0,
    .param .u64 scopes_param_1
)
{
    .reg .pred  %p<12>;
    .reg .b32   %r<39>;
    .reg .b64   %rd<38>;

    ld.param.u32        %r0, [scopes_param_0];
    ld.param.u64        %rd1, [scopes_param_1];
    cvta.to.global.u64  %rd1, %rd1;

$L_entry:
    setp.gt.s32         %p3, %r0, 0;
    @!%p3 bra           $L_if_end_2;

$L_if_then_1:
    mov.u32             %r30, 2;
    st.global.u32       [%rd1], %r30;

$L_if_end_2:
    mov.u32             %r21, 0;

$L_for_cond_3:
    setp.lt.s32         %p6, %r21, 2;
    @!%p6 bra           $L_for_end_6;

$L_for_body_4:
    mul.wide.s32        %rd31, %r21, 4;
    add.s64             %rd32, %rd1, %rd31;
    mov.u32             %r33, 0;
    st.global.u32       [%rd32], %r33;
    add.s32             %r9, %r21, 1;
    mov.u32             %r21, %r9;
    bra.uni             $L_for_cond_3;

$L_for_end_6:
    mov.u32             %r23, 0;

$L_for_cond_7:
    setp.lt.s32         %p11, %r23, 2;
    @!%p11 bra          $L_for_end_10;

$L_for_body_8:
    mul.wide.s32        %rd34, %r23, 4;
    add.s64             %rd35, %rd1, %rd34;
    ld.global.u32       %r12, [%rd35];
    add.s32             %r13, %r12, 1;
    mul.wide.s32        %rd36, %r23, 4;
    add.s64             %rd37, %rd1, %rd36;
    st.global.u32       [%rd37], %r13;
    add.s32             %r14, %r23, 1;
    mov.u32             %r23, %r14;
    bra.uni             $L_for_cond_7;

$L_for_end_10:
    mov.u32             %r38, 1;
    st.global.u32       [%rd1+4], %r38;
    ret;
}
