// One instance of every PTX instruction in the kitec lowering table
// (docs/PTX_BACKEND.md section 5). If ptxas accepts this file, the table is valid.
.version 7.0
.target sm_75
.address_size 64

.visible .entry opcode_table(
    .param .u32 opcode_table_param_0,
    .param .f32 opcode_table_param_1,
    .param .u64 opcode_table_param_2,
    .param .u64 opcode_table_param_3
)
{
    .reg .pred  %p<8>;
    .reg .b32   %r<24>;
    .reg .f32   %f<20>;
    .reg .b64   %rd<8>;

    ld.param.u32        %r0, [opcode_table_param_0];
    ld.param.f32        %f0, [opcode_table_param_1];
    ld.param.u64        %rd0, [opcode_table_param_2];
    cvta.to.global.u64  %rd0, %rd0;
    ld.param.u64        %rd1, [opcode_table_param_3];
    ld.param.u32        %r21, [opcode_table_param_0];
    setp.ne.s32         %p1, %r21, 0;           // bool param passed as u32 0/1
    cvta.to.global.u64  %rd1, %rd1;

    // special registers
    mov.u32             %r1, %tid.x;
    mov.u32             %r2, %tid.y;
    mov.u32             %r3, %ntid.x;
    mov.u32             %r4, %ctaid.y;
    mov.u32             %r5, %nctaid.x;

    // i32 arithmetic
    add.s32             %r6, %r1, %r2;
    sub.s32             %r7, %r6, 3;
    mul.lo.s32          %r8, %r7, %r3;
    div.s32             %r9, %r8, %r0;
    rem.s32             %r10, %r8, %r0;
    neg.s32             %r11, %r10;
    min.s32             %r12, %r11, %r9;
    max.s32             %r13, %r12, %r4;
    abs.s32             %r14, %r13;
    shl.b32             %r15, %r14, 3;
    mov.u32             %r16, %r15;
    mov.u32             %r17, 42;

    // f32 arithmetic (IEEE, round-to-nearest, never contracted)
    add.rn.f32          %f1, %f0, 0f3F800000;   // + 1.0
    sub.rn.f32          %f2, %f1, %f0;
    mul.rn.f32          %f3, %f2, %f1;
    div.rn.f32          %f4, %f3, %f1;
    neg.f32             %f5, %f4;
    abs.f32             %f6, %f5;
    min.f32             %f7, %f6, %f3;
    max.f32             %f8, %f7, %f2;
    sqrt.rn.f32         %f9, %f8;
    mul.rn.f32          %f10, %f9, 0f3FB8AA3B;  // x * log2(e)
    ex2.approx.f32      %f11, %f10;             // exp(x) = 2^(x*log2 e)
    mov.f32             %f12, %f11;
    mov.f32             %f13, 0fBF000000;       // -0.5

    // conversions
    cvt.rn.f32.s32      %f14, %r16;             // i32 -> f32
    cvt.rzi.s32.f32     %r18, %f14;             // f32 -> i32 (truncate, like C)

    // comparisons and bool logic
    setp.lt.s32         %p0, %r18, %r17;
    setp.ge.f32         %p1, %f12, %f13;
    setp.eq.s32         %p2, %r16, 0;
    setp.ne.f32         %p3, %f14, %f12;
    setp.neu.f32        %p3, %f14, %f12;        // C '!=' (true if either is NaN)
    xor.pred            %p2, %p2, %p3;          // bool !=
    and.pred            %p4, %p0, %p1;
    or.pred             %p5, %p2, %p3;
    not.pred            %p6, %p4;
    xor.pred            %p7, %p5, %p6;
    selp.s32            %r19, 1, 0, %p7;        // bool -> i32
    mov.pred            %p0, %p7;               // bool copy

    // memory
    mul.wide.s32        %rd2, %r19, 4;
    add.s64             %rd3, %rd0, %rd2;
    ld.global.f32       %f15, [%rd3];
    ld.global.u32       %r20, [%rd3];
    add.s64             %rd4, %rd1, %rd2;
    st.global.f32       [%rd4], %f15;
    st.global.u32       [%rd4], %r20;

    // control flow
    @%p0 bra            $L_a;
    @!%p0 bra           $L_b;
$L_a:
    bra.uni             $L_b;
$L_b:
    bar.sync            0;
    ret;
}
